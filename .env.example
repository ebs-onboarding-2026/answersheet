# ---------------------------------------------------------------------------
# Neon Postgres (Vercel Marketplace 연동 시 자동으로 채워집니다)
# Neon 콘솔 > Connection Details 에서 "Pooled connection" 문자열을 복사하세요.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# 마이그레이션처럼 풀러를 거치지 않아야 하는 작업용 (선택)
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# ---------------------------------------------------------------------------
# OpenAI — 문항 생성
# https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."

# 문항 생성에 쓸 모델 (선택, 기본값 gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"
